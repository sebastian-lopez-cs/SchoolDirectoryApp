@page "/schools"
@rendermode InteractiveServer
@using SchoolDirectoryApp.Components
@using SchoolDirectoryApp.Models
@using SchoolDirectoryApp.Services

@inject SchoolService SchoolService

<h1>School Directory</h1>

@if (error)
{
    <p>Unable to retrieve school data.</p>
}
else if (schools == null)
{
    <p>Loading schools...</p>
}
else
{
    @if (selectedSchool != null)
    {
        <SchoolDetails School="@selectedSchool" />
    }
    @foreach (var school in schools)
    {
        <SchoolCard School="@school"
                    OnSelect="HandleSchoolSelected" />
    }
}

@code {
    private List<School>? schools;
    private bool error = false;
    private School? selectedSchool;
    private void HandleSchoolSelected(School school)
    {
        selectedSchool = school;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            schools = await SchoolService.GetSchoolsAsync();
        }
        catch (Exception)
        {
            error = true;
        }
    }
}