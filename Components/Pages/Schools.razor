@page "/schools"
@rendermode InteractiveServer
@using SchoolDirectoryApp.Components
@using SchoolDirectoryApp.Models
@using SchoolDirectoryApp.Services

@inject SchoolService SchoolService

<h1>School Directory</h1>

<input @bind="Search"
       @bind:event="oninput"
       @bind:after="ClearSelection"
       class="form-control mb-3"
       placeholder="Search school..." />

<div class="mb-3">
    <button class="btn btn-outline-secondary me-2"
            @onclick="ToggleSort">
        Sort: @(sortAscending ? "A-Z" : "Z-A")
    </button>

    <button class="btn btn-outline-primary"
            @onclick="LoadSchoolsAsync">
        Refresh
    </button>
</div>

@if (error)
{
    <p>Unable to retrieve school data.</p>
}
else if (schools == null)
{
    <p>Loading schools...</p>
}
else
{
    <div class="d-flex gap-3 mb-3">
        <div class="border rounded px-3 py-2">
            <strong>Total Schools:</strong>
            @(schools?.Count ?? 0)
        </div>

        <div class="border rounded px-3 py-2">
            <strong>Results Shown:</strong>
            @FilteredSchools.Count()
        </div>
    </div>

    @if (selectedSchool != null)
    {
        <SchoolDetails School="@selectedSchool" />
    }

    <div class="row g-3">
        @foreach (var school in FilteredSchools)
        {
            <div class="col-12 col-lg-6">
                <SchoolCard School="@school"
                            OnSelect="HandleSchoolSelected" />
            </div>
        }
    </div>
}

@code {
    private List<School>? schools;
    private string Search = string.Empty;
    private bool error = false;
    private School? selectedSchool;
    private bool sortAscending = true;
   
    private async Task LoadSchoolsAsync()
    {
        schools = null;
        error = false;
        selectedSchool = null;

        try
        {
            schools = await SchoolService.GetSchoolsAsync();
        }
        catch (Exception)
        {
            error = true;
        }
    }

    private IEnumerable<School> FilteredSchools
    {
        get
        {
            var filtered = schools?
                .Where(s => s.SchoolName.Contains(
                    Search,
                    StringComparison.OrdinalIgnoreCase))
                ?? Enumerable.Empty<School>();

            return sortAscending
                ? filtered.OrderBy(s => s.SchoolName)
                : filtered.OrderByDescending(s => s.SchoolName);
        }
    }

    private void ToggleSort()
    {
        sortAscending = !sortAscending;
    }

    private void ClearSelection()
    {
        selectedSchool = null;
    }

    private void HandleSchoolSelected(School school)
    {
        selectedSchool = school;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSchoolsAsync();
    }
}